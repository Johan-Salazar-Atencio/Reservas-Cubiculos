    {
      "name": "2 · Cubículos",
      "item": [
        {
          "name": "Cubículos en vivo",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Hay 4 cubículos', () => pm.expect(r.cubiculos.length).to.eql(4));",
                  "const libre = r.cubiculos.find(c => c.estado === 'LIBRE');",
                  "pm.test('Hay al menos un cubículo libre', () => pm.expect(libre).to.exist);",
                  "pm.collectionVariables.set('cubiculoId', libre.id);",
                  "pm.collectionVariables.set('numeroCubiculo', libre.numero);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEstudiante}}",
                  "type": "string"
                }
              ]
            },
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cubiculos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cubiculos"
              ]
            }
          }
        },
        {
          "name": "Agenda de hoy",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Responde 200', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test('Hay 12 turnos (07:00 a 18:00)', () => pm.expect(r.horas.length).to.eql(12));",
                  "const c = r.cubiculos.find(x => x.id == pm.collectionVariables.get('cubiculoId'));",
                  "const slot = c.slots.find(s => s.estado === 'LIBRE');",
                  "pm.test('Hay un turno libre', () => pm.expect(slot).to.exist);",
                  "pm.collectionVariables.set('horaLibre', slot.hora);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenEstudiante}}",
                  "type": "string"
                }
              ]
